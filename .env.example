# ─── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# APP_URL is the investor portal base URL — used in email verification links
APP_URL=http://localhost:3001

# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aurum:aurum_secret@localhost:5432/aurum
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_REFRESH_EXPIRY=7d

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=aurum-api
KAFKA_GROUP_ID=aurum-api-group

# ─── KYC Provider ───────────────────────────────────────────────────────────────
# Options: stub | sumsub | onfido | persona
KYC_PROVIDER=stub
KYC_PROVIDER_API_URL=
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_SECRET=
KYC_WEBHOOK_SECRET=

# ─── Blockchain ─────────────────────────────────────────────────────────────────
RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
CHAIN_ID=1
AURUM_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# Hot wallet for minting — use a secrets manager in production
MINTER_PRIVATE_KEY=

# ─── Fees & Tax ─────────────────────────────────────────────────────────────────
# Aurum commission (% of gross), optional flat fee (USD), tax applied to the fee.
PLATFORM_FEE_PERCENT=1.5
PLATFORM_FEE_FLAT_USD=0
TAX_PERCENT=0

# ─── GoldBod Vault Integration ──────────────────────────────────────────────────
GOLDBOD_API_URL=https://api.goldbod.com/v1
GOLDBOD_API_KEY=
GOLDBOD_WEBHOOK_SECRET=
# Paystack subaccount that receives the gold-cost portion of each buyer charge
GOLDBOD_PAYSTACK_SUBACCOUNT=

# ─── SMS / Phone OTP ──────────────────────────────────────────────────────────
# Options: stub (logs the code to the API console) | arkesel
SMS_PROVIDER=stub
ARKESEL_API_KEY=
SMS_SENDER_ID=Aurum

# ─── FX rates ───────────────────────────────────────────────────────────────────
FX_API_URL=https://open.er-api.com/v6/latest/USD

# ─── Email ──────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@aurum.finance

# ─── Paystack ───────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# ─── Sumsub KYC ─────────────────────────────────────────────────────────────────
# Options: stub | sumsub
KYC_PROVIDER=stub
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_BASE_URL=https://api.sumsub.com
# KYC level name configured in your Sumsub dashboard
SUMSUB_LEVEL_NAME=basic-kyc-level

# ─── Observability ──────────────────────────────────────────────────────────────
LOG_LEVEL=debug
PROMETHEUS_PORT=9464
# Set a strong random token — Prometheus scraper must send: Authorization: Bearer <token>
# Leave empty in development to skip auth on /metrics
METRICS_TOKEN=

# ─── Admin Seed ─────────────────────────────────────────────────────────────────
# Used by: pnpm --filter @aurum/db db:seed
SEED_ADMIN_EMAIL=admin@aurum.finance
SEED_ADMIN_PASSWORD=ChangeMe!2025

# ─── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ─── Frontend (NEXT_PUBLIC_*) ────────────────────────────────────────────────────
# IMPORTANT: these are inlined at BUILD time. Set them, then rebuild the portals
# on the server — changing them after build has no effect.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_INVESTOR_URL=http://localhost:3001
NEXT_PUBLIC_INSTITUTIONAL_URL=http://localhost:3002
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Leave empty to keep embedded wallets off (falls back to MetaMask/WalletConnect)
NEXT_PUBLIC_PRIVY_APP_ID=
