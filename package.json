{
  "name": "aurum",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @aurum/db run db:generate",
    "db:migrate": "pnpm --filter @aurum/db run db:migrate",
    "db:studio": "pnpm --filter @aurum/db run db:studio",
    "infra:up": "docker compose -f docker-compose.infra.yml up -d",
    "infra:down": "docker compose -f docker-compose.infra.yml down",
    "dev:up": "docker compose -f docker-compose.yml up -d",
    "dev:down": "docker compose -f docker-compose.yml down",
    "clean": "turbo run clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.5.0",
    "prettier": "^3.3.0",
    "@types/node": "^20.14.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.5.0"
    }
  }
}
